  "patterns": [
    {
      "id": "forecast_price_level",
      "regex": "\\b(will|expected to|set to|going to) (reach|hit|surpass|grow to) (US)?\\$\\s?[\\d.,]+",
      "message": "Market forecast with a dollar level. Remove the forecast; describe the evidence instead.",
      "severity": "error"
    },
    {
      "id": "price_target",
      "regex": "\\b(price target|target price)\\b",
      "message": "Price target language is investment advice. Remove it.",
      "severity": "error"
    },
    {
      "id": "trade_call",
      "regex": "\\b(buy|sell|short) (the|this|that|these) (stock|shares|bonds?|coins?|tokens?)\\b",
      "message": "Trade call on a security. Remove it.",
      "severity": "error"
    },
    {
      "id": "investment_advice",
      "regex": "\\b(you should|you must|go ahead and|now is the time to) (buy|sell|invest|short)\\b",
      "message": "Direct investment advice. Remove it.",
      "severity": "error"
    },
    {
      "id": "employer_voice_role",
      "regex": "\\bas an? (executive|officer|director|vice president|vp|svp|head) (at|of|for)\\b",
      "message": "Speaks in an employer role. Rewrite in the personal voice, without titles or employers.",
      "severity": "error"
    },
    {
      "id": "employer_voice_bank",
      "regex": "\\b(at|inside|within) my (bank|employer|company|firm)\\b",
      "message": "Employer voice. Rewrite without referring to the owner's workplace.",
      "severity": "error"
    },
    {
      "id": "employer_voice_our",
      "regex": "\\bour (customers|clients|bank|users|shoppers)\\b",
      "message": "Speaks as the employer (\"our customers\"). Use the audience's or the market's words instead.",
      "severity": "error"
    },
    {
      "id": "verdict_on_entity",
      "regex": "\\b(is|are|was|were) (a |an )?(scam|fraud|ponzi|doomed|worthless|a joke)\\b",
      "message": "Verdict about a company or product. State the evidence and let the audience judge.",
      "severity": "error"
    }
  ]
}
